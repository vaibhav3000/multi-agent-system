LLM_PROVIDER=mock

# Use one provider at a time. Set LLM_PROVIDER to anthropic, groq, deepseek, gemini, or mock.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/agentdb
REDIS_URL=redis://redis:6379/0
CHROMA_PATH=/data/chroma
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=agentdb
