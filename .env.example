LLM_PROVIDER=deepseek

# Use one provider at a time. Set LLM_PROVIDER to deepseek, groq, gemini, or mock.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/agentdb
REDIS_URL=redis://redis:6379/0
CHROMA_PATH=/data/chroma
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=agentdb

# Anthropic API Key (if using LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

